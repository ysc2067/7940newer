# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# AI API Key (SiliconFlow / DeepSeek / OpenAI / any OpenAI-compatible provider)
AI_API_KEY=your-api-key-here

# AI Base URL (no trailing slash)
# Examples:
#   SiliconFlow: https://api.siliconflow.cn/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   OpenAI:      https://api.openai.com/v1
AI_BASE_URL=https://api.deepseek.com/v1

# AI Model name
# Examples:
#   SiliconFlow: deepseek-ai/DeepSeek-V3, Qwen/Qwen2.5-72B-Instruct
#   DeepSeek:    deepseek-chat
#   OpenAI:      gpt-4o
AI_MODEL=deepseek-chat

# (Optional) Proxy URL — only needed for local dev behind a proxy
# Leave unset or remove in production (Koyeb)
# PROXY_URL=http://127.0.0.1:7897
